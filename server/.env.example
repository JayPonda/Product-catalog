APP_ENV=local
HOST=localhost
PORT=3300
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth / JWT (JWT_SECRET must be a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

DB_HOST=localhost
DB_PORT=5432
DB_USER=product_catalog_user
DB_PASSWORD=product_catalog_password
DB_NAME=product_catalog_db
DB_SSLMODE=

DB_MAX_OPEN_CONNS=5
DB_MAX_IDLE_CONNS=2
DB_MAX_LIFETIME=6h
DB_MAX_IDLE_TIME=15m