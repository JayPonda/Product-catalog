# Copy to deploy/.env.production (or alongside docker-compose.prod.yml),
# fill in real values, and NEVER commit the filled-in file.

# --- Public URLs ---
# Frontend origin(s) allowed by the API's CORS middleware (comma separated,
# exact match, no trailing slash).
ALLOWED_ORIGINS=https://yourdomain.com
# Leave EMPTY for same-origin deployments (recommended: nginx proxies /api).
# Set a full URL (https://api.yourdomain.com) only if serving the API from
# its own domain — then ALLOWED_ORIGINS must include the frontend origin.
PUBLIC_API_URL=
HTTP_PORT=80

# --- Database ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=product_catalog_user
DB_PASSWORD=change-me-long-random-password
DB_NAME=product_catalog_db
# require = encrypt, verify-full = encrypt + verify identity (needs CA bundle)
DB_SSLMODE=require

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# --- Connection pool (keep total across replicas < Postgres max_connections) ---
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
